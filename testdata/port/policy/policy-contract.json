      ],
      "allow": false,
      "error": "blocked_private"
    },
    {
      "name": "link-local",
      "url": "http://169.254.10.10/",
      "addresses": [
        "169.254.10.10"
      ],
      "allow": false,
      "error": "blocked_private"
    },
    {
      "name": "carrier-grade-nat",
      "url": "http://100.64.0.1/",
      "addresses": [
        "100.64.0.1"
      ],
      "allow": false,
      "error": "blocked_private"
    },
    {
      "name": "ipv6-ula",
      "url": "http://[fd00::1]/",
      "addresses": [
        "fd00::1"
      ],
      "allow": false,
      "error": "blocked_private"
    },
    {
      "name": "ipv4-mapped",

        "::ffff:127.0.0.1"
      ],
      "allow": false,
      "error": "blocked_private"
    },
    {
      "name": "local-name",
      "url": "http://printer.local/",
      "addresses": [
        "192.168.1.7"
      ],
      "allow": false,
      "error": "blocked_private"
    },
    {
      "name": "localhost",
      "url": "http://localhost:3000/",
      "addresses": [
        "127.0.0.1"
      ],
      "allow": false,
      "error": "blocked_private"
    },
    {
      "name": "rebinding",
      "url": "http://rebind.example/",
      "addresses": [
        "93.184.216.34",
        "127.0.0.1"
      ],
      "allow": false,
      "error": "blocked_private"
    },
    {
      "name": "dns-failure",
      "url": "http://missing.example/",
      "addresses": null,
      "allow": false,
      "error": "DNS resolution failed"
    },
    {
      "name": "non-http",
      "url": "file:///etc/passwd",
      "addresses": [
        "127.0.0.1"
      ],
      "allow": false,
      "error": "blocked_private"
    },
    {
      "name": "backslash-authority-confusion",
      "url": "http://127.0.0.1\\@example.com/",
      "addresses": [
        "93.184.216.34"
      ],
      "allow": false,
      "error": "invalid URL"
    }
  ],

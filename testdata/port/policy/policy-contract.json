  "allowlists": [
    {
      "name": "exact-and-wildcard",
      "patterns": [
        "example.com",
        "*.example.org"
      ],
      "valid": true,
      "hosts": [
        {
          "host": "example.com",
          "allow": true
        },
        {
          "host": "www.example.com",
          "allow": false
        },
        {
          "host": "example.org",
          "allow": true
        },
        {
          "host": "a.b.example.org",
          "allow": true
        },
        {
          "host": "notexample.com",
          "allow": false
        }
      ],
      "urls": [
        {
          "url": "https://example.com/",
          "allow": true
        },
        {
          "url": "wss://a.example.org/socket",
          "allow": true
        },
        {
          "url": "file:///etc/passwd",
          "allow": false
        },
        {
          "url": "https://example.org.evil/",
          "allow": false
        },
        {
          "url": "http://127.0.0.1\\@example.com/",
          "allow": false
        },
        {
          "url": "http://example.com:bad/",
          "allow": false
        },
        {
          "url": " https://example.com/",
          "allow": false
        }
      ]
    },
    {
      "name": "case-and-trailing-dot",
      "patterns": [
        "EXAMPLE.COM.",
        "*.Example.ORG."
      ],
      "valid": true,
      "hosts": [
        {
          "host": "EXAMPLE.COM.",
          "allow": true
        },
        {
          "host": "WWW.EXAMPLE.ORG.",
          "allow": true
        }
      ]
    },
    {
      "name": "inactive",
      "patterns": null,
      "valid": true,
      "urls": [
        {
          "url": "https://anything.example/",
          "allow": true
        },
        {
          "url": "file:///etc/passwd",
          "allow": true
        }
      ]
    },
    {
      "name": "invalid-*",
      "patterns": [
        "*"
      ],
      "valid": false
    },
    {
      "name": "invalid-*.",
      "patterns": [
        "*."
      ],
      "valid": false
    },
    {
      "name": "invalid-http:__x.com",
      "patterns": [
        "http://x.com"
      ],
      "valid": false
    },
    {
      "name": "invalid-example.com:8080",
      "patterns": [
        "example.com:8080"
      ],
      "valid": false
    },
    {
      "name": "invalid-example.com_path",
      "patterns": [
        "example.com/path"
      ],
      "valid": false
    },
    {
      "name": "invalid-user@example.com",
      "patterns": [
        "user@example.com"
      ],
      "valid": false
    },
    {
      "name": "invalid-foo..example.com",
      "patterns": [
        "foo..example.com"
      ],
      "valid": false
    },
    {
      "name": "invalid-.example.com",
      "patterns": [
        ".example.com"
      ],
      "valid": false
    },
    {
      "name": "invalid-exa*mple.com",
      "patterns": [
        "exa*mple.com"
      ],
      "valid": false
    }
  ],
  "ssrf": [
    {

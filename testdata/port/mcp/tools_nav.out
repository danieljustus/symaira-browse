{"jsonrpc":"2.0","id":2,"result":{"tools":[{"description":"Navigate back in the page history. Use when: the previous page of this tab is needed. Do not use when: you need a fresh load of the same URL (use open or reload). Returns: the navigation result. Next: snapshot to inspect the previous page.","inputSchema":{"properties":{"session":{"description":"session name (default: default)","type":"string"}},"type":"object"},"name":"back"},{"description":"Navigate forward in the page history. Use when: a page you navigated back from is needed again. Do not use when: the target page is not in this tab history (use open). Returns: the navigation result. Next: snapshot to inspect the page.","inputSchema":{"properties":{"session":{"description":"session name (default: default)","type":"string"}},"type":"object"},"name":"forward"},{"description":"Reload the current page. Use when: the page changed server-side and a fresh load is needed. Do not use when: you only need to re-read the current DOM (use snapshot or read). Returns: the navigation result. Next: snapshot or read the reloaded page.","inputSchema":{"properties":{"session":{"description":"session name (default: default)","type":"string"}},"type":"object"},"name":"reload"}]}}
